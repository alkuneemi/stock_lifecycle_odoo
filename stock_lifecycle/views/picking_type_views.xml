<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_picking_type_form_inherit_signatories" model="ir.ui.view">
    <field name="name">stock.picking.type.form.signatories</field>
    <field name="model">stock.picking.type</field>
    <field name="inherit_id" ref="stock.view_picking_type_form"/>
    <field name="arch" type="xml">

      <xpath expr="//form/sheet/notebook" position="inside">
        <page string="المخولين بالتوقيع" name="signatories_page">
          <group>
            <group>
              <field name="manager_user_id"/>
              <field name="warehouse_manager_user_id"/>
              <field name="shipping_manager_user_id"/>
            </group>
          </group>
        </page>
      </xpath>
       <xpath expr="//field[@name='code']" position="before">
        <field name="has_transfer_lifecycle"/>
      </xpath>

    </field>
  </record>
</odoo>

